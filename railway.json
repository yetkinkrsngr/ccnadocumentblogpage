{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "dotnet publish server/CcnaBlog.Api/CcnaBlog.Api.csproj -c Release -o out"
    },
    "deploy": {
        "startCommand": "dotnet out/CcnaBlog.Api.dll",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}